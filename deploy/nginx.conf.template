# 电池通道监管台账 — Nginx 反向代理
# 由 install.sh 自动放到 /etc/nginx/sites-available/battery-tracker
# __DOMAIN__ 会被替换成你的域名

# 登录接口限速：按 IP 每分钟 12 次，防止有人暴力猜访问密码
limit_req_zone $binary_remote_addr zone=bt_login:10m rate=12r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # 上传/导出留足余量
    client_max_body_size 32m;

    # 不暴露 Nginx 版本号
    server_tokens off;

    access_log /var/log/nginx/battery-tracker.access.log;
    error_log  /var/log/nginx/battery-tracker.error.log;

    # ---- 登录接口：限速 ----
    location = /api/login {
        limit_req zone=bt_login burst=6 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    # ---- Service Worker：每次都要回源，否则 App 更新不了 ----
    location = /sw.js {
        proxy_pass http://127.0.0.1:8787/sw.js;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache" always;
    }

    # ---- 其余全部走应用 ----
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;

        # 静态资源缓存交给后端控制（后端已按文件类型给了 Cache-Control）
        proxy_buffering on;
    }

    # 关掉对 . 开头文件的访问
    location ~ /\.(?!well-known) {
        deny all;
    }
}
