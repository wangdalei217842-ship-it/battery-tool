# 电池通道监管台账 — Nginx（域名 + HTTPS）
# 由 deploy/enable_domain.sh 生成到 /etc/nginx/sites-available/battery-tracker
# 占位符：__DOMAIN__  __CERT_DIR__

# 登录接口限速：同一 IP 每分钟最多 12 次，防密码爆破
limit_req_zone $binary_remote_addr zone=bt_login:10m rate=12r/m;

# ---------- 80：只做证书验证 + 跳转 HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # 留给以后用 HTTP-01 续证书（备案下来后可直接用 certbot）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- 443：真正的入口 ----------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 强制浏览器以后只走 HTTPS（半年），确认稳定后再考虑加 preload
    # HSTS：半年内浏览器只走 HTTPS
    add_header Strict-Transport-Security "max-age=15552000" always;
    # 应用自己已发 X-Content-Type-Options / Referrer-Policy，这里不重复加，避免同头多值
    add_header X-Frame-Options           "SAMEORIGIN" always;

    client_max_body_size 32m;      # 方法附件最大 30MB，留点余量
    server_tokens off;

    access_log /var/log/nginx/battery-tracker.access.log;
    error_log  /var/log/nginx/battery-tracker.error.log;

    # ---- 登录接口：限速 ----
    location = /api/login {
        limit_req zone=bt_login burst=6 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
    }

    # ---- Service Worker：每次回源，保证 App 能更新 ----
    location = /sw.js {
        proxy_pass http://127.0.0.1:8787/sw.js;
        proxy_set_header Host $host;
        add_header Cache-Control "no-cache" always;
    }

    # ---- 其余全部走应用 ----
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
        proxy_buffering on;
    }

    # 禁止访问点开头的隐藏文件（保留 ACME 验证目录）
    location ~ /\.(?!well-known) {
        deny all;
    }
}
